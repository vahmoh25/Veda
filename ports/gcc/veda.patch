+/* The System V x86-64 ABI, LP64, as on GNU/Linux.  */
+
+#undef  ASM_SPEC
+#define ASM_SPEC "--64 %{msse2avx:%{!mavx:-msse2avx}}"
+
+#undef  CC1_SPEC
+#define CC1_SPEC "%(cc1_cpu)"
+
+/* The thread pointer (%fs) points at the thread control block, which
+   begins with itself.  */
+#undef  TARGET_TLS_DIRECT_SEG_REFS_DEFAULT
+#define TARGET_TLS_DIRECT_SEG_REFS_DEFAULT MASK_TLS_DIRECT_SEG_REFS
+
+#ifdef TARGET_LIBC_PROVIDES_SSP
+/* musl keeps the stack protector's canary where glibc does.  */
+#define TARGET_THREAD_SSP_OFFSET 0x28
+#endif
+
+/* -ffast-math sets the flush-to-zero and denormals-are-zero modes.  */
+#undef  ENDFILE_SPEC
+#define ENDFILE_SPEC \
+  "%{mdaz-ftz:crtfastmath.o%s;Ofast|ffast-math|funsafe-math-optimizations:%{!mno-daz-ftz:crtfastmath.o%s}} \
+   %{mpc32:crtprec32.o%s} %{mpc64:crtprec64.o%s} %{mpc80:crtprec80.o%s} " \
+  VEDA_ENDFILE_SPEC
+
+#define TARGET_ASM_FILE_END file_end_indicate_exec_stack
+
+/* The stack pointer needs to be moved while checking the stack.  */
+#define STACK_CHECK_MOVING_SP 1
+
