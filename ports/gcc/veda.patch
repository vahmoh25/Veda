+/* Definitions for Veda, a POSIX environment over a capability microkernel.
+   Copyright (C) 2026 Free Software Foundation, Inc.
+
+This file is part of GCC.
+
+GCC is free software; you can redistribute it and/or modify
+it under the terms of the GNU General Public License as published by
+the Free Software Foundation; either version 3, or (at your option)
+any later version.
+
+GCC is distributed in the hope that it will be useful,
+but WITHOUT ANY WARRANTY; without even the implied warranty of
+MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+GNU General Public License for more details.
+
+You should have received a copy of the GNU General Public License
+along with GCC; see the file COPYING3.  If not see
+<http://www.gnu.org/licenses/>.  */
+
+/* Veda's C library is musl, and every program is linked statically:
+   either at a fixed address (the default) or as a position-independent
+   executable that relocates itself (-static-pie).  The system lives under
+   /system: headers in /system/include, libraries and start files in
+   /system/lib.  */
+
+#undef  TARGET_OS_CPP_BUILTINS
+#define TARGET_OS_CPP_BUILTINS()		\
+  do						\
+    {						\
+      builtin_define ("__veda__");		\
+      builtin_define_std ("unix");		\
+      builtin_assert ("system=veda");		\
+      builtin_assert ("system=unix");		\
+      builtin_assert ("system=posix");		\
+    }						\
+  while (0)
+
+#undef  CPP_SPEC
+#define CPP_SPEC "%{posix:-D_POSIX_SOURCE} %{pthread:-D_REENTRANT}"
+
+/* The libraries and start files are in /system/lib (under the sysroot
+   when cross compiling).  */
+#undef  STANDARD_STARTFILE_PREFIX_1
+#define STANDARD_STARTFILE_PREFIX_1 "/system/lib/"
+#undef  STANDARD_STARTFILE_PREFIX_2
+#define STANDARD_STARTFILE_PREFIX_2 ""
+
+/* The compiler that runs on Veda finds the assembler and the linker with
+   the system's programs (a cross compiler does not look there).  */
+#undef  MD_EXEC_PREFIX
+#define MD_EXEC_PREFIX "/system/bin/"
+
+#define VEDA_PIE_SPEC "static-pie|pie"
+
+#undef  STARTFILE_SPEC
+#define STARTFILE_SPEC \
+  "%{" VEDA_PIE_SPEC ":rcrt1.o%s;:crt1.o%s} crti.o%s \
+   %{" VEDA_PIE_SPEC ":crtbeginS.o%s;:crtbeginT.o%s}"
+
+#define VEDA_ENDFILE_SPEC \
+  "%{" VEDA_PIE_SPEC ":crtendS.o%s;:crtend.o%s} crtn.o%s"
+
+#undef  ENDFILE_SPEC
+#define ENDFILE_SPEC VEDA_ENDFILE_SPEC
+
+/* musl has its threads in libc.  */
+#undef  LIB_SPEC
+#define LIB_SPEC "%{pthread:} -lc"
+
+#undef  LINK_SPEC
+#define LINK_SPEC \
+  "%{shared:%e-shared is not supported (Veda links programs statically)} \
+   %{" VEDA_PIE_SPEC ":-static -pie --no-dynamic-linker -z text;:-static} \
+   %{rdynamic:-export-dynamic} %{s:-s}"
+
+/* -pie means a static position-independent executable.  */
+#undef  LINK_PIE_SPEC
+#define LINK_PIE_SPEC ""
+
+/* The C library and libgcc refer to each other.  */
+#undef  LINK_GCC_C_SEQUENCE_SPEC
+#define LINK_GCC_C_SEQUENCE_SPEC "--start-group %G %{!nolibc:%L} --end-group"
+
+#if defined(HAVE_LD_EH_FRAME_HDR)
+#define LINK_EH_SPEC "%{" VEDA_PIE_SPEC ":--eh-frame-hdr} "
+#endif
+
+#define TARGET_POSIX_IO
+
+/* musl has the C99 functions and sincos.  */
+#undef  TARGET_LIBC_HAS_FUNCTION
+#define TARGET_LIBC_HAS_FUNCTION gnu_libc_has_function
+
+/* The C library is musl.  */
+#undef  OPTION_MUSL
+#define OPTION_MUSL 1
+#undef  OPTION_MUSL_P
+#define OPTION_MUSL_P(opts) 1
