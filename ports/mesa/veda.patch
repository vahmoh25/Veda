--- a/src/gallium/targets/veda/meson.build
+++ b/src/gallium/targets/veda/meson.build
@@ -0,0 +1,53 @@
+# Copyright © 2026 Vahid Mohammadi
+# SPDX-License-Identifier: MIT
+#
+# Veda's renderer: the virgl command streams of Veda's OpenGL ES library
+# carried out by a Gallium driver. Its sources are in the Veda repository
+# (services/renderer), which -Dveda-renderer names.
+
+veda_dir = get_option('veda-renderer')
+veda_sources = files(
+  veda_dir / 'src' / 'device.c',
+  veda_dir / 'src' / 'context.c',
+  veda_dir / 'src' / 'commands.c',
+  veda_dir / 'src' / 'formats.c',
+)
+veda_includes = [
+  inc_include, inc_src, inc_gallium, inc_gallium_aux, inc_gallium_drivers,
+  inc_gallium_winsys, inc_gallium_winsys_sw, inc_virtio_gpu,
+]
+
+if cc.get_define('__veda__') == ''
+  # For the host tests of Veda's OpenGL ES, a build for this machine:
+  # softpipe, which vgl's tests call through vgallium.dll (vgallium.so
+  # on Linux).
+  shared_library(
+    'vgallium',
+    veda_sources,
+    include_directories : veda_includes,
+    c_args : ['-DVR_EXPORTS', '-DVR_SOFTPIPE'],
+    gnu_symbol_visibility : 'hidden',
+    link_with : [libgallium, libws_null],
+    dependencies : [idep_nir, idep_mesautil, driver_softpipe],
+    name_prefix : '',
+  )
+else
+  # The renderer service, for Veda (x86_64-veda-gcc): softpipe, and iris
+  # for Intel's GPUs.
+  veda_args = ['-DVR_SOFTPIPE']
+  veda_deps = [idep_nir, idep_mesautil, driver_softpipe]
+  if with_gallium_iris
+    veda_args += '-DVR_IRIS'
+    veda_deps += [driver_iris, idep_xmlconfig]
+  endif
+  executable(
+    'renderer',
+    [veda_sources, files(veda_dir / 'src' / 'main.c', veda_dir / 'drm' / 'xf86drm.c')],
+    include_directories : veda_includes,
+    c_args : veda_args,
+    # BLAKE3's assembly marks its stack note for Linux only.
+    link_args : ['-Wl,-z,noexecstack'],
+    link_with : [libgallium, libws_null],
+    dependencies : veda_deps,
+  )
+endif
