--- a/src/intel/blorp/no-clc/blorp_shaders.h
+++ b/src/intel/blorp/no-clc/blorp_shaders.h
@@ -0,0 +1,32 @@
+/*
+ * Copyright © 2026 Vahid Mohammadi
+ * SPDX-License-Identifier: MIT
+ */
+
+/**
+ * @file blorp_shaders.h
+ *
+ * For builds without mesa_clc (Veda's): what blorp's blits and clears use
+ * of blorp_shaders.cl, written as NIR. The indirect copies (Vulkan's) are
+ * left out of such builds.
+ */
+
+#ifndef BLORP_SHADERS_H
+#define BLORP_SHADERS_H
+
+#include "compiler/nir/nir_builder.h"
+
+/* Whether pos (x, y) lies in bounds_rect (x0, x1, y0, y1; x1 and y1 past
+ * the end), as blorp_shaders.cl's blorp_check_in_bounds. */
+static inline nir_def *
+blorp_check_in_bounds(nir_builder *b, nir_def *bounds_rect, nir_def *pos)
+{
+   nir_def *x = nir_channel(b, pos, 0), *y = nir_channel(b, pos, 1);
+   nir_def *in_x = nir_iand(b, nir_uge(b, x, nir_channel(b, bounds_rect, 0)),
+                            nir_ult(b, x, nir_channel(b, bounds_rect, 1)));
+   nir_def *in_y = nir_iand(b, nir_uge(b, y, nir_channel(b, bounds_rect, 2)),
+                            nir_ult(b, y, nir_channel(b, bounds_rect, 3)));
+   return nir_iand(b, in_x, in_y);
+}
+
+#endif
