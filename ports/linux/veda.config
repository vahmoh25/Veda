# Linux for Veda's driver VM: the options `make allnoconfig` takes from
# here; everything else is off (EXPERT lets it turn off what is on by
# default elsewhere). The machine is Veda's paravirtual platform:
# processors with an x2APIC, memory, hypercalls, and nothing legacy.
CONFIG_EXPERT=y
CONFIG_64BIT=y
CONFIG_SMP=y
CONFIG_NR_CPUS=16
CONFIG_X86_X2APIC=y
CONFIG_HYPERVISOR_GUEST=y
CONFIG_VEDA_GUEST=y
CONFIG_HVC_VEDA=y
# Veda's IPC for the guest's programs (/dev/veda).
CONFIG_VIRT_DRIVERS=y
CONFIG_VEDA_BRIDGE=y
# Write-combining mappings, which device drivers ask for.
CONFIG_MTRR=y
CONFIG_X86_PAT=y
CONFIG_X86_UMIP=y

# The kernel, unpacked quickly; at the address it was built for.
CONFIG_KERNEL_ZSTD=y
CONFIG_RANDOMIZE_BASE=n

# What its programs need: an initial RAM file system of ELF programs,
# devices, processes, system information and settings, threads and
# their synchronisation, timers, shared memory.
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_ZSTD=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_DEVTMPFS=y
CONFIG_PROC_FS=y
CONFIG_PROC_SYSCTL=y
CONFIG_SYSFS=y
CONFIG_SHMEM=y
CONFIG_TMPFS=y
CONFIG_MULTIUSER=y
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_EVENTFD=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_POSIX_TIMERS=y
CONFIG_MEMBARRIER=y
CONFIG_MEMFD_CREATE=y
CONFIG_ADVISE_SYSCALLS=y
CONFIG_FILE_LOCKING=y
CONFIG_TTY=y
CONFIG_UNIX98_PTYS=y
# Device drivers load their firmware.
CONFIG_FW_LOADER=y
# A crash on request (/proc/sysrq-trigger), for the tests of the driver
# VM's restart; never from a keyboard: the keys typed are Veda's.
CONFIG_MAGIC_SYSRQ=y
CONFIG_MAGIC_SYSRQ_DEFAULT_ENABLE=0x0

# The PCI functions Veda gives the guest (arch/x86/pci/veda.c), with MSIs,
# which Veda's IOMMU remaps.
CONFIG_PCI=y
CONFIG_PCI_MSI=y
CONFIG_PCI_QUIRKS=y

# Network cards: Linux moves their frames (packet sockets) and has no IP
# stack (INET stays off): addresses and everything above are Veda's.
CONFIG_NET=y
CONFIG_PACKET=y
CONFIG_NETDEVICES=y
CONFIG_NET_CORE=y
CONFIG_ETHERNET=y
CONFIG_NET_VENDOR_INTEL=y
CONFIG_E1000=y
CONFIG_E1000E=y
CONFIG_IGB=y
CONFIG_ETHTOOL_NETLINK=y
CONFIG_IGC=y
CONFIG_NET_VENDOR_REALTEK=y
CONFIG_R8169=y

# Wi-Fi: Linux's 802.11 stack is the radios' MLME (guest/wifi), on Veda's
# Wi-Fi service's commands; the service decides and authenticates. The
# regulatory database comes as a firmware file, whose integrity is the
# initramfs's (Veda's), not a signature's.
CONFIG_WIRELESS=y
CONFIG_CFG80211=y
CONFIG_CFG80211_CERTIFICATION_ONUS=y
CONFIG_CFG80211_REQUIRE_SIGNED_REGDB=n
CONFIG_CFG80211_DEFAULT_PS=y
CONFIG_MAC80211=y
CONFIG_MAC80211_RC_MINSTREL=y
CONFIG_WLAN=y
# Intel's cards (iwlwifi), with their firmware's two kinds: iwlmvm's, and
# iwlmld's (Wi-Fi 7). Their firmware is in firmware.txt.
CONFIG_WLAN_VENDOR_INTEL=y
CONFIG_IWLWIFI=y
CONFIG_IWLMVM=y
CONFIG_IWLMLD=y
# Linux's simulated radio, which airlink (guest/airlink) makes of QEMU's
# virtual one: none of its own at boot.
CONFIG_MAC80211_HWSIM=y
CONFIG_CMDLINE_BOOL=y
CONFIG_CMDLINE="mac80211_hwsim.radios=0"

# USB: the controllers are Linux's (xHCI, which PCs have had since about
# 2012), with every device on them, each of which the log names, and their
# drivers: keyboards, mice and tablets (below), network adapters (CDC
# Ethernet and NCM, Realtek's and ASIX's), Bluetooth adapters.
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_ANNOUNCE_NEW_DEVICES=y
CONFIG_USB_PCI=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PCI=y
CONFIG_USB_NET_DRIVERS=y
CONFIG_USB_USBNET=y
CONFIG_USB_NET_CDCETHER=y
CONFIG_USB_NET_CDC_NCM=y
CONFIG_USB_RTL8152=y
CONFIG_USB_NET_AX88179_178A=y
CONFIG_BT=y
CONFIG_BT_BREDR=y
CONFIG_BT_LE=y
CONFIG_BT_HCIBTUSB=y

# Input: the event devices guest/input takes (evdev), of USB's HID class
# (keyboards, mice, tablets, touchscreens; ASUS's laptops' keyboards have
# their own driver), virtio's, and PS/2's. Nothing of Linux's acts on them.
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_HID_SUPPORT=y
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_HID_MULTITOUCH=y
CONFIG_NEW_LEDS=y
CONFIG_LEDS_CLASS=y
CONFIG_HID_ASUS=y
CONFIG_USB_HID=y
# The PC's keyboard controller, when Veda gives it (arch/x86/kernel/cpu/
# veda.c): PS/2 keyboards and mice, touchpads among them (Synaptics', ALPS',
# Elantech's protocols...).
CONFIG_SERIO=y
CONFIG_SERIO_I8042=y
CONFIG_SERIO_LIBPS2=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_KEYBOARD_ATKBD=y
CONFIG_INPUT_MOUSE=y
CONFIG_MOUSE_PS2=y
CONFIG_MOUSE_PS2_ALPS=y
CONFIG_MOUSE_PS2_BYD=y
CONFIG_MOUSE_PS2_LOGIPS2PP=y
CONFIG_MOUSE_PS2_SYNAPTICS=y
CONFIG_MOUSE_PS2_CYPRESS=y
CONFIG_MOUSE_PS2_TRACKPOINT=y
CONFIG_MOUSE_PS2_ELANTECH=y
CONFIG_MOUSE_PS2_FOCALTECH=y

# Displays and GPUs: guest/kms shows the compositor's frames through KMS,
# and guest/renderer renders through Mesa's driver of the GPU on its render
# node. Intel's integrated GPUs (i915); QEMU's virtio-gpu, which renders on
# the host's GPU, and its standard VGA, for tests. No console on them: the
# screen is Veda's.
CONFIG_DRM=y
CONFIG_DRM_I915=y
CONFIG_DRM_VIRTIO_GPU=y
CONFIG_DRM_VIRTIO_GPU_KMS=y
CONFIG_DRM_BOCHS=y

# virtio devices (QEMU's, modern ones): network cards, input devices, the
# ports of a console.
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_INPUT=y
CONFIG_VIRTIO_CONSOLE=y

# Sound: Intel's HD Audio controllers, and their codecs; virtio's sound
# devices (QEMU's).
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_PROC_FS=y
CONFIG_SND_HDA_INTEL=y
CONFIG_SND_HDA_GENERIC=y
CONFIG_SND_VIRTIO=y

# Its own log, with times, and readable backtraces when something fails.
CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y
CONFIG_BUG=y
CONFIG_DEBUG_BUGVERBOSE=y
CONFIG_KALLSYMS=y

# Time: tickless, high resolution.
CONFIG_NO_HZ_IDLE=y
CONFIG_HIGH_RES_TIMERS=y

# Nothing the platform lacks.
CONFIG_ACPI=n
CONFIG_EFI=n
CONFIG_DMI=n
CONFIG_ISA_DMA_API=n
CONFIG_VT=n
CONFIG_SERIAL_8250=n
CONFIG_MODULES=n
CONFIG_IA32_EMULATION=n
CONFIG_X86_16BIT=n
CONFIG_X86_VSYSCALL_EMULATION=n
CONFIG_CPU_MITIGATIONS=n
