# The agent's screenshots in the README (1280x800), taken with the stand-in
# for Deepgram (no key needed). Regenerate them with
#
#   cargo xtask script docs/screenshots-agent.vts
#
# which writes docs/images/agent.png and docs/images/agent-approval.png.
fail-on "PANIC"
wait-serial "desktop ready" 90
mic-silence 1
agent-connected 120
wait-serial "interface attached" 30
# "Write my shopping list": the agent opens the Text Editor and writes it.
agent-call use_app '{"app":"editor","action":"write","arguments":{"text":"Shopping list\n\nMilk\nSourdough bread\nApples\nCoffee beans\nFresh basil\nParmesan\nOlive oil\n"}}' 60
agent-result written
agent-call use_app '{"app":"editor","action":"save","arguments":{"path":"~/Documents/Shopping list.txt"}}' 30
agent-result saved
wait 4
# The agent's window, while it answers.
click 0.825 0.97
wait 2
move 0.45 0.55
agent-speak 6
wait 2
shot docs/images/agent.png
wait 5
# Deleting needs the user's OK: the request in the agent's window.
agent-call files '{"operation":"write","path":"~/Documents/Old notes.txt","text":"..."}' 30
agent-call files '{"operation":"delete","path":"~/Documents/Old notes.txt"}' 30
agent-result waiting_for_approval
wait 3
shot docs/images/agent-approval.png
