# The Terminal's agent interface, with a simulated Voice Agent service.
# Running a command waits for the user's OK (the request shows the exact
# command line) and returns what the command printed. A long command keeps
# running while the agent reads its output, and stops when the agent
# interrupts it. A Wi-Fi password typed in a command never reaches the
# agent, a command line too long to show in full is refused, and the agent
# clears the screen and changes the text size.
fail-on "PANIC"
wait-serial "desktop ready" 120
mic-silence 1
agent-connected 120
wait-serial "state: Listening" 30
# The Terminal starts for the agent and describes itself.
agent-call app_actions '{"app":"terminal"}' 60
agent-result run_command
wait-serial "terminal offers" 10
agent-call read_app '{"app":"terminal"}' 30
agent-result '"folder":"~","running":null,"last_exit_status":0'
# A command runs once the user allows it, and its output comes back.
agent-call use_app '{"app":"terminal","action":"run_command","arguments":{"command":"mkdir -p ~/agent && cd ~/agent && echo hello from the agent > note.txt && ls -w"}}' 30
agent-result waiting_for_approval
wait-serial "approval 1 requested: Runs a command in the terminal (command: mkdir -p ~/agent && cd ~/agent" 10
click 0.825 0.97
wait 2
shot target/veda/agent-app-terminal-1-approval.png
agent-mark
click 0.9375 0.8275
wait-serial "approval 1 allowed" 10
agent-expect "it was done" 20
agent-expect "note.txt" 5
agent-call read_app '{"app":"terminal"}' 30
agent-result '"folder":"~/agent","running":null,"last_exit_status":0'
agent-result "echo hello from the agent > note.txt && ls -w\nnote.txt"
# A long command keeps running in the background; the agent stops it.
agent-call use_app '{"app":"terminal","action":"run_command","arguments":{"command":"echo waiting; sleep 60; echo not reached"}}' 30
wait-serial "approval 2 requested" 10
wait 1
agent-mark
click 0.9375 0.8275
wait-serial "approval 2 allowed" 10
agent-expect "still running" 20
agent-call use_app '{"app":"terminal","action":"read_output","arguments":{"lines":3}}' 30
agent-result '"running":{"command":"echo waiting; sleep 60; echo not reached"'
agent-result "waiting\n"
wait 1
shot target/veda/agent-app-terminal-2-running.png
agent-call use_app '{"app":"terminal","action":"interrupt"}' 30
agent-result '"stopped":true'
agent-call use_app '{"app":"terminal","action":"read_output"}' 30
agent-result "waiting\n^C\n"
agent-result '"running":null,"last_exit_status":130'
agent-call use_app '{"app":"terminal","action":"interrupt"}' 30
agent-result "no command is running"
# A Wi-Fi password in a command line does not reach the agent.
agent-call use_app '{"app":"terminal","action":"run_command","arguments":{"command":"wifi connect Home secret-password-1"}}' 30
wait-serial "approval 3 requested" 10
wait 1
agent-mark
click 0.9375 0.8275
wait-serial "approval 3 allowed" 10
agent-expect "it was done" 20
agent-call use_app '{"app":"terminal","action":"interrupt"}' 30
agent-call use_app '{"app":"terminal","action":"read_output"}' 30
agent-result "wifi connect Home ********"
# A command line longer than the approval shows is refused.
agent-call use_app '{"app":"terminal","action":"run_command","arguments":{"command":"echo 0123456789 0123456789 0123456789 0123456789 0123456789 0123456789 0123456789 0123456789"}}' 30
wait-serial "approval 4 requested" 10
wait 1
agent-mark
click 0.9375 0.8275
wait-serial "approval 4 allowed" 10
agent-expect "longer than 80 characters" 20
# The screen is cleared and the text made bigger; the next command shows.
agent-call use_app '{"app":"terminal","action":"clear_screen"}' 30
agent-result '"cleared":true'
agent-call read_app '{"app":"terminal"}' 30
agent-result '"output":"","earlier_lines":0'
agent-call use_app '{"app":"terminal","action":"set_text_size","arguments":{"points":20}}' 30
agent-result '"text_size":20'
agent-call use_app '{"app":"terminal","action":"run_command","arguments":{"command":"cat note.txt"}}' 30
wait-serial "approval 5 requested" 10
wait 1
agent-mark
click 0.9375 0.8275
wait-serial "approval 5 allowed" 10
agent-expect "hello from the agent" 20
# The agent's window closed, the Terminal shows what the agent did.
click 0.825 0.97
wait 2
shot target/veda/agent-app-terminal-3-done.png
