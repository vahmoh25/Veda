# The agent's interface with a simulated Voice Agent service: the tray item,
# the window with its circle, and an approval request answered in the
# window (denied, then allowed).
fail-on "PANIC"
wait-serial "desktop ready" 120
mic-silence 1
agent-connected 120
wait-serial "interface attached" 30
wait 2
shot target/veda/agent-1-tray.png
# The tray's circle opens the agent's window.
click 0.825 0.97
wait 2
shot target/veda/agent-2-window.png
agent-speak 3
wait 1
shot target/veda/agent-3-speaking.png
wait 3
# Deleting a file needs consent: the request appears in the window.
agent-call files '{"operation":"write","path":"~/Documents/note.txt","text":"hello"}' 30
agent-result saved
agent-call files '{"operation":"delete","path":"~/Documents/note.txt"}' 30
agent-result waiting_for_approval
wait-serial "approval 1 requested" 10
wait 2
shot target/veda/agent-4-approval.png
agent-mark
click 0.867 0.8275
wait-serial "approval 1 declined" 10
agent-expect declined 20
agent-call files '{"operation":"info","path":"~/Documents/note.txt"}' 30
agent-result note.txt
# Asked again and allowed: the file goes.
agent-call files '{"operation":"delete","path":"~/Documents/note.txt"}' 30
wait-serial "approval 2 requested" 10
wait 1
agent-mark
click 0.9375 0.8275
wait-serial "approval 2 allowed" 10
agent-expect "it was done" 20
agent-call files '{"operation":"info","path":"~/Documents/note.txt"}' 30
agent-result "no such file"
