# Settings → Agent: the page the shell's "Open Settings" button opens. With
# no Deepgram key the agent asks for one; a key that is not a Deepgram key
# is refused before it is stored, and a well-formed one is stored (only its
# last characters are ever shown). The voice and model lists come from
# Deepgram, so here (no key Deepgram accepts) they say what went wrong.
fail-on "PANIC"
boot-cmdline "run=settings:agent"
wait-serial "desktop ready" 120
wait-serial "started settings" 60
wait 4
key meta_l-up
wait 4
shot target/veda/agent-settings-1.png
# The key field, then a key with the wrong shape.
click 0.38 0.315
type "not-a-key"
key ret
wait 2
shot target/veda/agent-settings-2-refused.png
reject-serial "Deepgram key stored"
# A key of the right shape is stored.
key ctrl-a
type "0123456789abcdef0123456789abcdef01234567"
key ret
wait-serial "Deepgram key stored" 20
wait 3
shot target/veda/agent-settings-3-stored.png
reject-serial "0123456789abcdef0123456789abcdef01234567"
# The rest of the page (dragging the scroll bar to the end).
drag 0.9935 0.2 0.9935 0.95
wait 2
shot target/veda/agent-settings-4-end.png
