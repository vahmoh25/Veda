# A display driver that goes away in the middle of the startup sequence
# (`flipsim=40`, as one that crashed would), leaving one of its pictures on
# the screen: the compositor goes on drawing in place, into the pictures
# and the firmware's framebuffer, and the sequence plays to its end and the
# desktop comes, whole, as without a driver (1280x800).
gpu off
boot-cmdline "flipsim=40"
fail-on "PANIC"
wait-serial "flipsim: going away after 40 flips" 120
wait-serial "compositor: flipsim went away" 30
wait-serial "compositor: desktop shown after" 120
expect-serial "drawn in place: flipsim went away"
wait 3
move 0.5 0.98
wait 1
shot target/veda/flips-gone.png
reject-serial "no desktop after"
