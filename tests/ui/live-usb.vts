# The live system (`cargo xtask iso`) started from a USB stick, as a PC starts
# it: the desktop comes up with the home directory in memory, and no disk
# driver runs, so the computer's disks are never touched. The USB driver
# sees the stick but leaves it unconfigured.
live
fail-on "PANIC"
wait-serial "desktop ready" 120
expect-serial "home directory in memory (live system)"
expect-serial "live system: ahci not started"
reject-serial "devmgr: started ahci"
reject-serial "devmgr: started virtio-blk"
wait-serial "QEMU USB HARDDRIVE (46f4:0001, SuperSpeed): storage device, not used" 30
wait 4
shot target/veda/live-usb.png
