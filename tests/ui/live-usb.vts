# The live system (`cargo xtask iso`) started from a USB stick, as a PC
# starts it: the desktop comes up with the home directory in memory, and no
# disk driver runs, so the computer's disks are never touched.
live
fail-on "PANIC"
wait-serial "desktop ready" 120
expect-serial "home directory in memory (live system)"
expect-serial "live system: ahci not started"
reject-serial "devmgr: started ahci"
reject-serial "devmgr: started virtio-blk"
wait 4
shot target/veda/live-usb.png
