# The compositor's flips (1280x800), on a display that flips at the
# vertical blank: QEMU's VGA played by `flipsim`, as Intel's display engine
# is by `intel-gpu`. The startup sequence and the desktop reach the screen
# through the driver's pictures, a frame a vertical blank. What changes
# while one picture is on the screen reaches the other before it is shown:
# a window moved about, maximised, restored and put away leaves nothing
# behind in either picture.
gpu off
boot-cmdline "flipsim"
boot-cmdline "run=editor"
fail-on "PANIC"
wait-serial "compositor: flipsim attached" 120
wait-serial "compositor: desktop shown after" 120
expect-serial "flipped by flipsim"
wait-serial "started editor" 60
wait 6
# The desktop alone (Super+D), the pointer where the taskbar (below 0.94)
# has no button.
move 0.1 0.98
key meta_l-d
wait 3
shot target/veda/flips-1-desktop.png
# The editor back, dragged by its title bar (y = 36), maximised, restored.
key meta_l-d
wait 2
drag 0.3125 0.045 0.6 0.5
wait 1
key meta_l-up
wait 2
key meta_l-down
wait 2
shot target/veda/flips-2-window.png
# The desktop alone again: the picture on the screen, then the other one
# and the first again (each move of the pointer is a frame).
move 0.1 0.98
key meta_l-d
wait 3
shot target/veda/flips-3-desktop.png
move 0.15 0.98
wait 1
shot target/veda/flips-4-desktop.png
move 0.2 0.98
wait 1
shot target/veda/flips-5-desktop.png
expect-same target/veda/flips-1-desktop.png target/veda/flips-3-desktop.png 0 0 1 0.93
expect-same target/veda/flips-1-desktop.png target/veda/flips-4-desktop.png 0 0 1 0.93
expect-same target/veda/flips-1-desktop.png target/veda/flips-5-desktop.png 0 0 1 0.93
reject-serial "stopped answering"
reject-serial "flipsim went away"
reject-serial "cannot have the screen"
