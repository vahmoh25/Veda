# Intel HD Audio (the sound hardware of most PCs), in QEMU: the ICH9's
# controller with QEMU's output codec. The driver resets the controller,
# reads the codec and routes its line output; the Music player's track
# plays through it (its position moves on as the card plays) and reaches
# the recording of the sound output.
sound hda
boot-cmdline "run=music"
fail-on "PANIC"
wait-serial "hda: codec 0: QEMU HDA codec (1af4:0012): line out (pin 0x03)" 60
wait-serial "hda: attached to the audio service" 60
wait-serial "music: library: 7 track(s)" 90
wait-serial "music: covers: 7 ready" 60
wait 1
click 0.6188 0.8125
wait-serial "music: playing Neon Horizon" 30
wait 6
key spc
wait-serial "music: paused at 0:0" 10
reject-serial "music: paused at 0:00"
reject-serial "hda: underrun 10"
reject-serial "no answer from node"
expect-audio
