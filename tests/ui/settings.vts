# Settings (1280x800 with the taskbar): applying wallpapers through the
# desktop shell with the mouse and with the keyboard, and the Agent,
# Network, Display, System and About pages. Settings logs every wallpaper change.
boot-cmdline "run=settings"
wait-serial "desktop ready" 90
wait-serial "started settings" 60
wait 4
# Maximise the window (Super+Up): the gallery has four columns, and the
# second wallpaper (Dunes) is at (0.492, 0.616).
key meta_l-up
wait 4
shot target/vindows/settings-1-personalization.png
click 0.492 0.616
wait-serial "settings: wallpaper changed to /system/wallpapers/Dunes.jpg" 40
wait 2
shot target/vindows/settings-2-dunes.png
# The keyboard: Right moves to the next wallpaper, Enter applies it.
key right
wait 1
key ret
wait-serial "settings: wallpaper changed to /system/wallpapers/Nebula.jpg" 40
wait 2
# Up and Down switch between the pages.
key down
wait 3
shot target/vindows/settings-3-agent.png
key down
wait 3
shot target/vindows/settings-3-network.png
key down
wait 2
shot target/vindows/settings-3-display.png
key down
wait 2
shot target/vindows/settings-4-system.png
key down
wait 2
shot target/vindows/settings-5-about.png
reject-serial "cannot change the wallpaper"
