# The network through Linux's driver: QEMU's Intel 82576 card (igb, which
# Veda has no driver of its own for) goes to the driver VM. Linux's igb
# drives it, and Veda's network driver for Linux attaches it to Veda's
# network service as eth0, which gets its address by DHCP; nettest checks
# DNS, TCP, HTTP and ping through it.
requires drivervm
iommu
net ethernet
nic igb
boot-cmdline "drivervm drivervm.devices=8086:10c9"
boot-cmdline "run=nettest"
fail-on "PANIC"
fail-on "drivervm: processor"
fail-on "nettest: FAIL"
wait-serial "goes to the driver VM" 60
wait-serial "net: eth0 (igb, pci 00:" 90
wait-serial "net: eth0: attached as eth0" 30
wait-serial "nettest: PASS" 300
reject-serial "iommu: unit at"
reject-serial "Linux touched I/O port"
