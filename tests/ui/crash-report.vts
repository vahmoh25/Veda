# A crashing application is reported: start a program that faults on
# purpose from the Terminal and check that the shell shows a notification.
fail-on "PANIC"
boot-cmdline "run=terminal"
wait-serial "desktop ready" 90
wait 4
type "run systest crash"
key ret
wait-serial "systest crashed" 20
wait-serial "shell: systest closed unexpectedly" 10
wait 1
shot target/veda/crash-report.png
