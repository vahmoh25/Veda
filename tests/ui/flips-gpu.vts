# The compositor's frames drawn by a GPU (1280x800): the renderer serves
# the `gpu` protocol on softpipe and draws into the pictures of a display
# that flips (QEMU's VGA played by `flipsim`), as Mesa's iris draws into
# intel-gpu's on a PC. The GPU is set up once the driver has attached, its
# drawing is checked, and from then on it draws every frame: the startup
# sequence and the desktop. What a picture lacks of the screen is copied
# from the other: the desktop shows the same from either. softpipe is slow
# under emulation (seconds for a frame of the whole screen), so the script
# waits long, and leaves windows to flips.vts.
requires renderer
gpu off
boot-cmdline "flipsim"
boot-cmdline "run=renderer"
fail-on "PANIC"
fail-on "POSIX layer panic"
fail-on "frames stay with the processor"
fail-on "frames are drawn by the processor from now on"
fail-on "memory to render into refused"
wait-serial "compositor: flipsim attached" 120
wait-serial "compositor: frames are drawn by the GPU (softpipe) from now on" 120
wait-serial "drawn by the GPU (softpipe))" 400
wait 30
# The desktop, the pointer where the taskbar (below 0.94) has no button:
# the picture on the screen, then the other one and the first again (each
# move of the pointer is a frame).
move 0.1 0.98
wait 30
shot target/veda/flips-gpu-1-desktop.png
move 0.15 0.98
wait 20
shot target/veda/flips-gpu-2-desktop.png
move 0.2 0.98
wait 20
shot target/veda/flips-gpu-3-desktop.png
expect-same target/veda/flips-gpu-1-desktop.png target/veda/flips-gpu-2-desktop.png 0 0 1 0.93
expect-same target/veda/flips-gpu-1-desktop.png target/veda/flips-gpu-3-desktop.png 0 0 1 0.93
reject-serial "stopped answering"
reject-serial "flipsim went away"
reject-serial "cannot have the screen"
