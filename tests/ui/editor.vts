# Text Editor smoke test (1280x800 screen): open Welcome.txt from the
# desktop, edit it, search it and save it.
fail-on "PANIC"
wait-serial "desktop ready" 90
wait 2
# Double-click the fourth desktop icon (Welcome.txt).
double-click 0.0469 0.4425
wait-serial "started editor" 30
wait 6
shot target/veda/editor-1-open.png
key ctrl-end
type "Edited by the automated test."
key ret
key ctrl-home
wait 2
shot target/veda/editor-2-typed.png
key ctrl-f
type "shortcuts"
wait 3
shot target/veda/editor-3-find.png
key esc
key ctrl-s
wait 3
shot target/veda/editor-4-saved.png
reject-serial "editor crashed"
