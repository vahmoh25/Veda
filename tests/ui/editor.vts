# Text Editor smoke test (1280x800 screen): start on a new document, write
# in it, search it and save it.
boot-cmdline "run=editor:/home/user/Documents/Shortcuts.txt"
fail-on "PANIC"
wait-serial "desktop ready" 90
wait-serial "started editor" 60
wait 6
shot target/veda/editor-1-open.png
type "Keyboard shortcuts: Ctrl+F finds, Ctrl+S saves."
key ret
type "Edited by the automated test."
key ret
key ctrl-home
wait 2
shot target/veda/editor-2-typed.png
key ctrl-f
type "shortcuts"
wait 3
shot target/veda/editor-3-find.png
key esc
key ctrl-s
wait 3
shot target/veda/editor-4-saved.png
reject-serial "editor crashed"
