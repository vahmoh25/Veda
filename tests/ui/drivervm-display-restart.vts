# The window system restarted while Linux's display driver is attached
# (QEMU's VGA in the driver VM, as in drivervm-display.vts; systest
# restarts the compositor among its tests, 1280x800): `kms` attaches again
# to the new compositor, and the desktop comes back through its pictures.
requires drivervm
iommu
gpu off
boot-cmdline "drivervm drivervm.devices=1234:1111"
boot-cmdline "systest"
fail-on "PANIC"
fail-on "systest: FAIL"
wait-serial "compositor: bochs-drm (Linux) attached" 120
wait-serial "systest: PASS" 240
expect-serial "kms: bochs-drm (Linux): the compositor went away"
wait-serial-count "compositor: bochs-drm (Linux) attached" 2 30
wait-serial-count "shell: desktop ready" 2 60
wait 3
# The pointer moves (the first move after the restart is lost: it finds
# the input driver's old connection closed), and the frame shows it.
move 0.5 0.98
wait 0.5
move 0.1 0.98
wait 1
shot target/veda/drivervm-display-restart.png
reject-serial "stopped answering"
reject-serial "cannot have the screen"
reject-serial "bochs-drm (Linux) went away"
