# Wi-Fi failure recovery through Linux's 802.11 stack (see
# drivervm-wifi.vts): the failures of wifi-recovery.vts, with the radio a
# managed one in the driver VM. Linux notices the access point gone (its
# beacons, its acknowledgements) and leaves it; the access point's own
# deauthentications come through Linux to Veda's station; Veda decides
# what to join again. `checkpoint` makes the following waits look only at
# what is logged after it.
requires drivervm
iommu
net wifi
boot-cmdline "drivervm drivervm.devices=1af4:1043"
boot-cmdline "run=nettest:wifi-watch"
fail-on "PANIC"
fail-on "drivervm: processor"
fail-on "nettest: FAIL"
wait-serial "wifi: wlan0: offered to the Wi-Fi service" 120
wait-serial "watch: wifi=connected ap=02:56:57:00:00:01 ping=ok dns=ok" 300
air-expect "list" "1 joined"

# 1. The access point disappears: the second access point of the network
#    takes over.
checkpoint
air "ap home off"
wait-serial "lost the connection to Veda Home" 60
wait-serial "watch: wifi=connected ap=02:56:57:00:00:02 ping=ok dns=ok" 120
air "ap home on"

# 2. The access point disconnects us: Veda joins again, after looking
#    around, through the stronger first access point (back on).
checkpoint
air "ap home2 deauth 3"
wait-serial "the access point disconnected" 60
wait-serial "watch: wifi=connected ap=02:56:57:00:00:01 ping=ok dns=ok" 120

# 3. The network behind the access point fails and comes back; the Wi-Fi
#    connection itself stays up.
checkpoint
air "wired down"
wait-serial "watch: wifi=connected ap=02:56:57:00:00:01 ping=fail dns=fail" 60
checkpoint
air "wired up"
wait-serial "watch: wifi=connected ap=02:56:57:00:00:01 ping=ok dns=ok" 60

# 4. Out of range of every access point of the network, then back in range.
checkpoint
air "ap home2 off"
air "ap home signal -95"
wait-serial "watch: wifi=disconnected" 60
checkpoint
air "ap home signal -50"
wait-serial "watch: wifi=connected ap=02:56:57:00:00:01 ping=ok dns=ok" 120
air "ap home2 on"

# 5. The medium goes silent for a few seconds (airsim's side of the radio
#    disconnects): Linux loses the access point, and Veda joins it again.
checkpoint
air "radio drop 5"
wait-serial "lost the connection to Veda Home" 30
wait-serial "watch: wifi=connected ap=02:56:57:00:00:01 ping=ok dns=ok" 120

# 6. New group keys and a lossy link: the connection survives both.
checkpoint
air "ap home rekey"
air "ap home loss 10"
wait 15
air "ap home loss 0"
wait 3
reject-serial "lost the connection"
air-expect "list" "1 joined"

# 7. The Wi-Fi service itself is ended: init restarts it, Linux's radio is
#    offered again, and the saved network is rejoined.
key meta_l
wait 2
type "terminal"
key ret
wait-serial "started terminal" 30
wait 4
checkpoint
type "kill -f wlan"
key ret
wait-serial "restarting wlan" 30
wait-serial "wifi: wlan0: offered to the Wi-Fi service" 60
wait-serial "watch: wifi=connected ap=02:56:57:00:00:01 ping=ok dns=ok" 120
reject-serial "panicked"
reject-serial "the Wi-Fi adapter refused a command"
reject-serial "iommu: unit at"
