# Window snapping (1280x800): drag the Text Editor to the right screen edge
# (with a preview while dragging), then drag it away to restore its size.
boot-cmdline "run=editor"
fail-on "PANIC"
wait-serial "started editor" 60
wait 6
# Grab the title bar (top of the screen) and move to the right edge.
mouse-down 0.3125 0.0225
move 0.6 0.3
move 1.0 0.4
wait 1
shot target/veda/snap-1-preview.png
mouse-up
wait 2
shot target/veda/snap-2-right.png
# The snapped window covers the right half; dragging its title bar away
# restores its previous size.
drag 0.75 0.0225 0.4 0.3
wait 2
shot target/veda/snap-3-restored.png
reject-serial "crashed"
