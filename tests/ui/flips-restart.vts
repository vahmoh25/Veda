# The window system restarted while a display that flips is attached
# (QEMU's VGA played by `flipsim`; systest restarts the compositor among
# its tests, 1280x800): the driver lets the new compositor draw into the
# firmware's framebuffer until it attaches to it again, and the desktop
# comes back through the driver's pictures.
gpu off
boot-cmdline "flipsim"
boot-cmdline "systest"
fail-on "PANIC"
fail-on "systest: FAIL"
wait-serial "compositor: flipsim attached" 120
wait-serial "systest: PASS" 240
expect-serial "flipsim: the compositor went away"
wait-serial-count "compositor: flipsim attached" 2 30
wait-serial-count "shell: desktop ready" 2 60
wait 3
# The pointer moves (the first move after the restart is lost: it finds
# the input driver's old connection closed), and the frame shows it.
move 0.5 0.98
wait 0.5
move 0.1 0.98
wait 1
shot target/veda/flips-restart.png
reject-serial "stopped answering"
reject-serial "cannot have the screen"
reject-serial "flipsim went away"
