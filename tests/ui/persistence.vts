# The home directory survives a reboot (1280x800): write a note on the
# desktop, restart the machine, and open it again from there.
fail-on "PANIC"
wait-serial "desktop ready" 90
expect-serial "home directory new, on the home disk"
# The Terminal creates Note.txt on the desktop and opens it in the Text
# Editor; write a line and save.
key meta_l
wait 2
type "terminal"
key ret
wait-serial "started terminal" 30
wait 4
type "edit Desktop/Note.txt && exit"
key ret
wait-serial "started editor" 30
wait 5
type "Persistence check: this line was saved before a reboot."
key ret
key ctrl-s
wait 3
reset
wait-serial "desktop ready" 90
expect-serial "home directory restored from the home disk"
# Double-click the fifth desktop icon (Note.txt, after Home, Velocity,
# Starfall and Prism).
double-click 0.0469 0.565
wait-serial "started editor" 30
wait 5
shot target/veda/persist-after-reboot.png
