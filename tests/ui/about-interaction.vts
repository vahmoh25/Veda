# Interaction smoke test for the About window (1280x800 screen).
fail-on "PANIC"
wait-serial "started about" 60
wait 6
# Drag the title bar 200 px to the right and 60 px down.
drag 0.30 0.162 0.4562 0.2370
wait 1
shot target/vindows/ui-1-dragged.png
# Toggle "Show licences" (now at about x=0.42, y=0.665).
click 0.4235 0.665
wait 2
shot target/vindows/ui-2-toggled.png
# Click OK: the window should close.
click 0.752 0.757
wait 2
shot target/vindows/ui-3-closed.png
expect-serial "about exited with code 0"
