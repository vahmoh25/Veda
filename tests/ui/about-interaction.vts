# Interaction smoke test for the About window (1280x800 screen with the
# taskbar): move the window, flip a toggle, close it with OK.
boot-cmdline "run=about"
fail-on "PANIC"
wait-serial "started about" 60
wait 6
# Drag the title bar (y = 56) 200 px to the right and 60 px down.
drag 0.3516 0.07 0.5078 0.145
wait 1
shot target/veda/ui-1-dragged.png
# Toggle "Show licences" (moved with the window to x = 543, y = 457).
click 0.4242 0.5713
wait 2
shot target/veda/ui-2-toggled.png
# Click OK (x = 963, y = 631): the window should close.
click 0.7523 0.7888
wait 2
shot target/veda/ui-3-closed.png
expect-serial "about exited with code 0"
