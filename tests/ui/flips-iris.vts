# The display's pictures offered to Mesa's iris on gemsim, a stand-in for
# the test laptop's GPU that runs nothing (1280x800). iris takes them as on
# a PC: each picture a dma-buf, imported through the render node into the
# GPU driver's buffers (PRIME_FD_TO_HANDLE, gem::import), a linear render
# target. The compositor then checks that what the GPU draws reaches the
# pictures' memory; on gemsim it never does, so frames stay with the
# processor, and the desktop comes all the same.
requires renderer
gpu off
boot-cmdline "flipsim"
boot-cmdline "run=gemsim"
boot-cmdline "run=renderer:iris"
fail-on "PANIC"
fail-on "POSIX layer panic"
fail-on "memory to render into refused"
fail-on "cannot draw into the display's pictures"
fail-on "frames are drawn by the GPU"
wait-serial "compositor: flipsim attached" 120
wait-serial "renderer: serving gpu on Mesa Intel" 180
wait-serial "compositor: frames stay with the processor: what Mesa Intel" 180
expect-serial "does not reach the display's memory"
wait-serial "compositor: desktop shown after" 120
expect-serial "flipped by flipsim"
reject-serial "stopped answering"
