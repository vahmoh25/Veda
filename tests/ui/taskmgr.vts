# Task Manager (1280x800 with the taskbar): the process table (search,
# sorting, context menu), ending an application with confirmation, the
# extra warning for system processes, and the performance graphs.
boot-cmdline "run=taskmgr"
wait-serial "desktop ready" 90
wait-serial "started taskmgr" 60
wait 3
# Maximise the window (Super+Up): the positions below assume it.
key meta_l-up
wait 2
# Start About from the start menu, to have an application to end.
key meta_l
wait 2
type "about"
key ret
wait-serial "started about" 30
wait 3
shot target/vindows/taskmgr-1-processes.png
# Search for it (the search box is right of About's window), select it with
# Enter, end it with Delete and confirm.
click 0.795 0.081
type "about"
wait 1
key ret
wait 1
key delete
wait 1
shot target/vindows/taskmgr-2-confirm.png
key ret
wait-serial "about exited with code -1002" 30
# A system process asks with a stronger warning; Esc cancels.
click 0.795 0.081
key ctrl-a
type "vfs"
wait 1
key ret
wait 1
key delete
wait 1
shot target/vindows/taskmgr-3-system.png
key esc
wait 1
reject-serial "vfs exited"
# Clear the search (Esc in the box) and sort by memory (column header).
click 0.795 0.081
wait 1
key esc
wait 1
click 0.8375 0.1375
wait 2
shot target/vindows/taskmgr-4-by-memory.png
click 0.2 0.224 right
wait 1
shot target/vindows/taskmgr-5-menu.png
key esc
# The Performance tab: CPU, then Memory.
key ctrl-2
wait 5
shot target/vindows/taskmgr-6-cpu.png
click 0.098 0.275
wait 2
shot target/vindows/taskmgr-7-memory.png
