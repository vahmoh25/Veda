# Velocity: start a race from the title screen, let the computer drive and
# pause. The game must keep rendering (its frame statistics reach the log).
boot-cmdline "run=racer"
fail-on "PANIC"
wait-serial "racer: ready" 90
wait 3
shot target/veda/racer-1-title.png
key ret
wait 1
key f8
wait-serial "autopilot on" 10
wait 12
shot target/veda/racer-2-race.png
expect-serial "fps, work"
key esc
wait 2
shot target/veda/racer-3-paused.png
