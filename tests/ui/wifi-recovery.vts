# Wi-Fi failure recovery. nettest joins (and saves) the simulated network
# "Veda Home", then reports every change it notices (Wi-Fi state and
# access point, ping to the gateway, DNS). The script breaks the network
# through airsim in different ways; each time Veda must recover on its
# own, without anyone touching it. `checkpoint` makes the following waits
# look only at what is logged after it.
net wifi
boot-cmdline "run=nettest:wifi-watch"
fail-on "nettest: FAIL"
wait-serial "watch: wifi=connected ap=02:56:57:00:00:01 ping=ok dns=ok" 300
air-expect "list" "1 joined"

# 1. The access point disappears: the second access point of the network
#    takes over.
checkpoint
air "ap home off"
wait-serial "lost the connection to Veda Home" 60
wait-serial "watch: wifi=connected ap=02:56:57:00:00:02 ping=ok dns=ok" 120
air "ap home on"

# 2. The access point disconnects us: Veda joins again, after looking
#    around, through the stronger first access point (back on).
checkpoint
air "ap home2 deauth 3"
wait-serial "the access point disconnected" 60
wait-serial "watch: wifi=connected ap=02:56:57:00:00:01 ping=ok dns=ok" 120

# 3. The network behind the access point fails and comes back; the Wi-Fi
#    connection itself stays up.
checkpoint
air "wired down"
wait-serial "watch: wifi=connected ap=02:56:57:00:00:01 ping=fail dns=fail" 60
checkpoint
air "wired up"
wait-serial "watch: wifi=connected ap=02:56:57:00:00:01 ping=ok dns=ok" 60

# 4. The DNS server cannot resolve for a while.
checkpoint
air "dns servfail"
wait-serial "watch: wifi=connected ap=02:56:57:00:00:01 ping=ok dns=servfail" 60
checkpoint
air "dns normal"
wait-serial "watch: wifi=connected ap=02:56:57:00:00:01 ping=ok dns=ok" 60

# 5. Out of range of every access point of the network, then back in range.
checkpoint
air "ap home2 off"
air "ap home signal -95"
wait-serial "watch: wifi=disconnected" 60
checkpoint
air "ap home signal -50"
wait-serial "watch: wifi=connected ap=02:56:57:00:00:01 ping=ok dns=ok" 120
air "ap home2 on"

# 6. The radio vanishes for a few seconds (its host side disconnects).
checkpoint
air "radio drop 5"
wait-serial "the Wi-Fi adapter stopped working" 30
wait-serial "the Wi-Fi adapter is working again" 60
wait-serial "watch: wifi=connected ap=02:56:57:00:00:01 ping=ok dns=ok" 120

# 7. New group keys and a lossy link: the connection survives both.
checkpoint
air "ap home rekey"
air "ap home loss 10"
wait 15
air "ap home loss 0"
wait 3
reject-serial "lost the connection"
air-expect "list" "1 joined"

# 8. The Wi-Fi service itself is ended: init restarts it, the radio
#    driver offers the radio again, and the saved network is rejoined.
key meta_l
wait 2
type "terminal"
key ret
wait-serial "started terminal" 30
wait 4
checkpoint
type "kill -f wlan"
key ret
wait-serial "restarting wlan" 30
wait-serial "attached to the network service as wlan0" 60
wait-serial "watch: wifi=connected ap=02:56:57:00:00:01 ping=ok dns=ok" 120
shot target/veda/wifi-recovery.png
reject-serial "panicked"
