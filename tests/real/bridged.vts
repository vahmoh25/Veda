# Vindows on the host's real network (VirtualBox, bridged to the host's
# adapter): its address, gateway and DNS server come from the real router
# by DHCP, and nettest checks DNS, UDP, TCP, HTTP and ping through it on
# the real Internet. Depends on the host's network, so it is not part of
# `cargo xtask test`:
#
#   cargo xtask script tests/real/bridged.vts --vm virtualbox
requires virtualbox
net bridged
boot-cmdline "run=nettest:lan"
fail-on "nettest: FAIL"
wait-serial "nettest: real network ... ok" 120
wait-serial "nettest: PASS" 180
reject-serial "panicked"
